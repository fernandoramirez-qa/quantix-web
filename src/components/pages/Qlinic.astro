---
import { t, getLangFromUrl, localizedPath, splitTitle, kicker } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const items = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'];
const [name, subtitle] = splitTitle(t('cli.head.title', lang));
---
<section class="sec first" style="padding-top:96px"><div class="wrap">
  <p class="kicker">{kicker(t('cli.head.eyebrow', lang))}</p>
  <h1 class="h-product">{name}</h1>
  <p class="subtitle">{subtitle}</p>
  <p class="lead" style="max-width:660px">{t('cli.head.lead', lang)}</p>
  <a class="btn btn-primary" href={localizedPath('contacto', lang)}>{t('cta.demo', lang)}</a>
</div></section>
<section class="sec"><div class="wrap feats">
  {items.map((c) => (
    <div class="feat-item"><h3>{t(`cli.${c}.t`, lang)}</h3><p>{t(`cli.${c}.d`, lang)}</p></div>
  ))}
</div></section>
<section class="sec"><div class="wrap note">
  <h2>{t('cli.compliance.b', lang)}</h2>
  <p>{t('cli.compliance.d', lang)}</p>
</div></section>
<section class="ctaband"><div class="wrap">
  <h2>{t('cli.cta.title', lang)}</h2>
  <p>{t('cli.cta.sub', lang)}</p>
  <a class="btn btn-primary" href={localizedPath('contacto', lang)}>{t('cta.demo', lang)}</a>
</div></section>
