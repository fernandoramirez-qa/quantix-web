---
import { t, getLangFromUrl, localizedPath, plain } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const L = (slug: string) => localizedPath(slug, lang);
---
<section class="sec first" style="padding-top:88px"><div class="wrap">
  <div class="split">
    <div class="txt">
      <h1 class="h-xl">{t('hx.hero.title', lang)}</h1>
      <p class="lead-lg">{t('hx.hero.lead', lang)}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#productos">{t('hx.hero.cta', lang)}</a>
        <a class="btn btn-ghost" href={L('contacto')}>{t('common.cta.contactUs', lang)}</a>
      </div>
    </div>
    <figure class="media pulso">
      <div class="pulso-head"><span class="pulso-title"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="#2fd1c5" fill-opacity="0.25" /><circle cx="7" cy="7" r="3.5" fill="#2fd1c5" /></svg>{t('hx.pulse.title', lang)}</span><span class="pulso-badge">{t('hx.pulse.badge', lang)}</span></div>
      <p class="pulso-sub">{t('hx.pulse.sub', lang)}</p>
      <svg viewBox="0 0 520 250" width="100%" role="img" aria-label={t('hx.pulse.aria', lang)}>
        <g stroke="#ffffff" stroke-opacity="0.08" stroke-width="1"><path d="M0 50 H520" /><path d="M0 120 H520" /><path d="M0 190 H520" /></g>
        <g fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 110 L72 116 L136 108 L200 120 L264 116 L328 124 L392 120 L456 128 L500 132" stroke-opacity="0.28" />
          <path d="M8 150 L72 146 L136 152 L200 144 L264 150 L328 146 L392 152 L456 148 L500 150" stroke-opacity="0.2" />
          <path d="M8 186 L72 190 L136 184 L200 192 L264 186 L328 190 L392 194 L456 188 L500 192" stroke-opacity="0.14" />
        </g>
        <path d="M8 196 L72 188 L120 192 L150 164 L176 206 L204 150 L236 172 L272 158 L328 138 L360 146 L392 112 L424 120 L456 84 L500 66 L500 250 L8 250 Z" fill="#2fd1c5" fill-opacity="0.1" />
        <path class="pulso-line" d="M8 196 L72 188 L120 192 L150 164 L176 206 L204 150 L236 172 L272 158 L328 138 L360 146 L392 112 L424 120 L456 84 L500 66" fill="none" stroke="#2fd1c5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="500" cy="66" r="14" fill="#2fd1c5" fill-opacity="0.2" /><circle cx="500" cy="66" r="6.5" fill="#2fd1c5" />
        <g font-family="inherit" font-size="13">
          <rect x="372" y="22" width="112" height="28" rx="14" fill="#2fd1c5" />
          <text x="428" y="41" text-anchor="middle" fill="#0d1a2d" font-weight="700">{t('hx.pulse.you', lang)}</text>
          <text x="8" y="100" fill="#ffffff" fill-opacity="0.55">{t('hx.pulse.rival', lang)} A</text>
          <text x="8" y="140" fill="#ffffff" fill-opacity="0.45">{t('hx.pulse.rival', lang)} B</text>
          <text x="8" y="176" fill="#ffffff" fill-opacity="0.4">{t('hx.pulse.rival', lang)} C</text>
        </g>
      </svg>
      <div class="pulso-chips"><span>{t('hx.pulse.c1', lang)}</span><span>{t('hx.pulse.c2', lang)}</span><span>{t('hx.pulse.c3', lang)}</span></div>
      <p class="pulso-qpasa"><b>Qpasa:</b> {t('hx.pulse.qpasa', lang)}</p>
    </figure>
  </div>
  <nav id="productos" class="idx" aria-label={t('nav.products', lang)}>
    <a href="#qpulso"><b>QPulso</b><span>{t('hx.idx.qp', lang)}</span></a>
    <a href="#flow"><b>Quantix Flow</b><span>{t('hx.idx.flow', lang)}</span></a>
    <a href="#qjuridico"><b>QJurídico</b><span>{t('hx.idx.jur', lang)}</span></a>
    <a href="#qlanza"><b>QLanza</b><span>{t('hx.idx.lanza', lang)}</span></a>
    <a href="#qlinic"><b>Qlinic</b><span>{t('hx.idx.cli', lang)}</span></a>
  </nav>
</div></section>

<section class="sec" id="qpulso"><div class="wrap split">
  <div class="txt">
    <p class="kicker">{t('hx.qps.for', lang)}</p>
    <h2 class="h-lg">QPulso</h2>
    <p class="lead">{t('hx.qps.desc', lang)}</p>
    <ul style="margin:0 0 34px;padding-left:20px;display:grid;gap:10px;font-size:17px;color:var(--ink2)">
      <li>{t('hx.qps.li1', lang)}</li><li>{t('hx.qps.li2', lang)}</li><li>{t('hx.qps.li3', lang)}</li><li>{t('hx.qps.li4', lang)}</li>
    </ul>
    <a class="btn btn-primary" href={L('contacto')}>{t('hx.qps.cta', lang)}</a>
  </div>
  <div class="media qcards">
    <div><span>{t('hx.qps.l1', lang)}</span><b>{t('hx.qps.q1', lang)}</b></div>
    <div><span>{t('hx.qps.l2', lang)}</span><b>{t('hx.qps.q2', lang)}</b></div>
    <div><span>{t('hx.qps.l3', lang)}</span><b>{t('hx.qps.q3', lang)}</b></div>
    <div class="dark"><span>{t('hx.qps.l4', lang)}</span><b>{t('hx.qps.q4', lang)}</b></div>
  </div>
</div></section>

<section class="sec" id="qpasa"><div class="wrap">
  <div class="split">
    <div class="txt">
      <p class="kicker">{t('hx.qp.kicker', lang)}</p>
      <h2 class="h-lg">{t('hx.qp.title', lang)}</h2>
      <p style="margin:0 0 16px;font-size:23px;line-height:1.35;max-width:480px">{t('hx.qp.sub', lang)}</p>
      <p class="lead" style="margin:0">{t('hx.qp.desc', lang)}</p>
    </div>
    <figure class="media qphones">
      <div class="qphone" role="img" aria-label={t('hx.ph.aria1', lang)}>
        <div class="qp-head"><svg class="qp-q" viewBox="20 20 172 172" aria-hidden="true"><path d="M117.2 154.3 A62 62 0 1 1 154.3 117.2" fill="none" stroke="#0d1a2d" stroke-width="20" stroke-linecap="round" /><path d="M120 120 L172 172" fill="none" stroke="#1f7d77" stroke-width="20" stroke-linecap="round" /></svg>Qpasa <span>{t('hx.ph.app', lang)}</span></div>
        <div class="qp-body">
          <div class="qp-user">{t('hx.ph.p1.user', lang)}</div>
          <div class="qp-voice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1f7d77" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /></svg><svg width="100%" height="26" viewBox="0 0 120 26" aria-hidden="true"><g stroke="#1f7d77" stroke-width="3" stroke-linecap="round"><path d="M6 10v6" /><path d="M14 6v14" /><path d="M22 3v20" /><path d="M30 8v10" /><path d="M38 5v16" /><path d="M46 10v6" /><path d="M54 2v22" /><path d="M62 7v12" /><path d="M70 4v18" /><path d="M78 9v8" /><path d="M86 6v14" /><path d="M94 11v4" /></g></svg></div>
          <div class="qp-bot">{t('hx.ph.p1.bot', lang)}</div>
          <div class="qp-foot">{t('hx.ph.p1.foot', lang)}</div>
        </div>
      </div>
      <div class="qphone low" role="img" aria-label={t('hx.ph.aria2', lang)}>
        <div class="qp-head"><svg class="qp-q" viewBox="20 20 172 172" aria-hidden="true"><path d="M117.2 154.3 A62 62 0 1 1 154.3 117.2" fill="none" stroke="#0d1a2d" stroke-width="20" stroke-linecap="round" /><path d="M120 120 L172 172" fill="none" stroke="#1f7d77" stroke-width="20" stroke-linecap="round" /></svg>Qpasa <span>{t('hx.ph.app', lang)}</span></div>
        <div class="qp-body">
          <div class="qp-user">{t('hx.ph.p2.user', lang)}</div>
          <div class="qp-bot">{t('hx.ph.p2.bot', lang)}</div>
          <div class="qp-chart"><span>{t('hx.ph.p2.chart', lang)}</span><svg width="100%" height="58" viewBox="0 0 160 58" aria-hidden="true"><path d="M2 46 L30 42 L46 30 L58 48 L72 26 L92 30 L112 16 L136 12 L158 6" fill="none" stroke="#1f7d77" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /><path d="M2 34 L40 36 L80 32 L120 38 L158 36" fill="none" stroke="#c9d2dc" stroke-width="2" stroke-linecap="round" /></svg></div>
          <span class="qp-link">{t('hx.ph.p2.link', lang)}</span>
        </div>
      </div>
      <div class="qphone" role="img" aria-label={t('hx.ph.aria3', lang)}>
        <div class="qp-head"><svg class="qp-q" viewBox="20 20 172 172" aria-hidden="true"><path d="M117.2 154.3 A62 62 0 1 1 154.3 117.2" fill="none" stroke="#0d1a2d" stroke-width="20" stroke-linecap="round" /><path d="M120 120 L172 172" fill="none" stroke="#1f7d77" stroke-width="20" stroke-linecap="round" /></svg>Qpasa <span>{t('hx.ph.app', lang)}</span></div>
        <div class="qp-body">
          <div class="qp-user">{t('hx.ph.p3.user', lang)}</div>
          <div class="qp-bot">{t('hx.ph.p3.bot', lang)}</div>
          <div class="qp-doc"><i>PDF</i><div><b>{t('hx.ph.p3.doc', lang)}</b><span>{t('hx.ph.p3.docsub', lang)}</span></div></div>
          <span class="qp-btn">{t('hx.ph.p3.btn', lang)}</span>
        </div>
      </div>
    </figure>
  </div>
  <div style="margin-top:96px;padding-top:56px;border-top:1px solid var(--line)">
    <h3 style="margin:0 0 10px;font-size:clamp(28px,3vw,36px);letter-spacing:-.02em">{t('hx.qp.erp.title', lang)}</h3>
    <p class="lead" style="margin-bottom:40px">{t('hx.qp.erp.lead', lang)}</p>
    <ol class="steps">
      <li><div class="n">1</div><b>{t('hx.qp.s1.t', lang)}</b><p>{t('hx.qp.s1.d', lang)}</p></li>
      <li><div class="n">2</div><b>{t('hx.qp.s2.t', lang)}</b><p>{t('hx.qp.s2.d', lang)}</p></li>
      <li><div class="n">3</div><b>{t('hx.qp.s3.t', lang)}</b><p>{t('hx.qp.s3.d', lang)}</p></li>
    </ol>
    <a class="btn btn-primary" href={L('contacto')}>{t('hx.qp.cta', lang)}</a>
  </div>
</div></section>

<section class="sec" id="flow"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.flow.for', lang)}</p><h2 class="h-md" style="margin:0">Quantix Flow</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('flow.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.flow.more', lang)}</p>
    <a class="link-strong" href={L('quantix-flow')}>{t('cta.know', lang)} Quantix Flow</a>
  </div>
</div></section>

<section class="sec" id="qjuridico"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.jur.for', lang)}</p><h2 class="h-md" style="margin:0">QJurídico</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('jur.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.jur.more', lang)}</p>
    <a class="link-strong" href={L('qjuridico')}>{t('cta.know', lang)} QJurídico</a>
  </div>
</div></section>

<section class="sec" id="qlanza"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.lanza.for', lang)}</p><h2 class="h-md" style="margin:0">QLanza</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('lanza.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.lanza.more', lang)}</p>
    <a class="link-strong" href={L('qlanza')}>{t('cta.know', lang)} QLanza</a>
  </div>
</div></section>

<section class="sec" id="qlinic"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.cli.for', lang)}</p><h2 class="h-md" style="margin:0">Qlinic</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('cli.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.cli.more', lang)}</p>
    <a class="link-strong" href={L('qlinic')}>{t('cta.know', lang)} Qlinic</a>
  </div>
</div></section>

<section class="sec" id="nosotros"><div class="wrap">
  <h2 class="h-md" style="margin-bottom:48px">{t('work.title', lang)}</h2>
  <div class="feats">
    <div class="feat-item"><h3>{t('work.p1.t', lang)}</h3><p>{t('work.p1.d', lang)}</p></div>
    <div class="feat-item"><h3>{t('work.p2.t', lang)}</h3><p>{t('work.p2.d', lang)}</p></div>
    <div class="feat-item"><h3>{t('work.p3.t', lang)}</h3><p>{t('work.p3.d', lang)}</p></div>
  </div>
</div></section>

<section class="ctaband" id="contacto"><div class="wrap">
  <h2>{t('contact.head.title', lang)}.</h2>
  <p>{t('contact.head.lead', lang)}</p>
  <div class="btn-row">
    <a class="btn btn-primary" href="https://wa.me/573164749204">{t('hx.cta.whatsapp', lang)}</a>
    <a class="btn btn-ghost" href="mailto:info@quantixanalitic.com">info@quantixanalitic.com</a>
  </div>
</div></section>
