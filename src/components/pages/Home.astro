---
import { t, getLangFromUrl, localizedPath, plain } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const L = (slug: string) => localizedPath(slug, lang);
---
<section class="sec first" style="padding-top:88px"><div class="wrap">
  <div class="split">
    <div class="txt">
      <h1 class="h-xl">{t('hx.hero.title', lang)}</h1>
      <p class="lead-lg">{t('hx.hero.lead', lang)}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#productos">{t('hx.hero.cta', lang)}</a>
        <a class="btn btn-ghost" href={L('contacto')}>{t('common.cta.contactUs', lang)}</a>
      </div>
    </div>
    <figure class="media">
      <img class="shot" src="/assets/mirfe-consumo-riego.webp" alt={t('hx.hero.alt', lang)} width="1149" height="1220" fetchpriority="high" />
    </figure>
  </div>
  <nav id="productos" class="idx" aria-label={t('nav.products', lang)}>
    <a href="#viewq"><b>viewQ</b><span>{t('hx.idx.vq', lang)}</span></a>
    <a href="#flow"><b>Quantix Flow</b><span>{t('hx.idx.flow', lang)}</span></a>
    <a href="#qjuridico"><b>QJurídico</b><span>{t('hx.idx.jur', lang)}</span></a>
    <a href="#qlanza"><b>QLanza</b><span>{t('hx.idx.lanza', lang)}</span></a>
    <a href="#qlinic"><b>Qlinic</b><span>{t('hx.idx.cli', lang)}</span></a>
  </nav>
</div></section>

<section class="sec" id="viewq"><div class="wrap split">
  <div class="txt">
    <p class="kicker">{t('hx.vq.for', lang)}</p>
    <h2 class="h-lg">viewQ</h2>
    <p class="lead">{t('hx.vq.desc', lang)}</p>
    <ul style="margin:0 0 34px;padding-left:20px;display:grid;gap:10px;font-size:17px;color:var(--ink2)">
      <li>{t('hx.vq.li1', lang)}</li><li>{t('hx.vq.li2', lang)}</li><li>{t('hx.vq.li3', lang)}</li><li>{t('hx.vq.li4', lang)}</li>
    </ul>
    <a class="btn btn-primary" href={L('viewq')}>{t('cta.know', lang)} viewQ</a>
  </div>
  <figure class="media phones two">
    <img src="/assets/mipe-recorrido.webp" alt={t('hx.vq.alt1', lang)} width="700" height="1521" loading="lazy" />
    <img class="low" src="/assets/mipe-incidencia.webp" alt={t('hx.vq.alt2', lang)} width="700" height="1521" loading="lazy" />
  </figure>
</div></section>

<section class="sec" id="qpasa"><div class="wrap">
  <div class="split">
    <div class="txt">
      <p class="kicker">{t('hx.qp.kicker', lang)}</p>
      <h2 class="h-lg">{t('hx.qp.title', lang)}</h2>
      <p style="margin:0 0 16px;font-size:23px;line-height:1.35;max-width:480px">{t('hx.qp.sub', lang)}</p>
      <p class="lead" style="margin:0">{t('hx.qp.desc', lang)}</p>
    </div>
    <figure class="media phones three">
      <img src="/assets/qpasa-voz.webp" alt={t('hx.qp.alt1', lang)} width="591" height="1280" loading="lazy" />
      <img class="low" src="/assets/qpasa-proyeccion-aguacate.webp" alt={t('hx.qp.alt2', lang)} width="591" height="1280" loading="lazy" />
      <img src="/assets/qpasa-proyeccion-flores.webp" alt={t('hx.qp.alt3', lang)} width="591" height="1280" loading="lazy" />
    </figure>
  </div>
  <div style="margin-top:96px;padding-top:56px;border-top:1px solid var(--line)">
    <h3 style="margin:0 0 10px;font-size:clamp(28px,3vw,36px);letter-spacing:-.02em">{t('hx.qp.erp.title', lang)}</h3>
    <p class="lead" style="margin-bottom:40px">{t('hx.qp.erp.lead', lang)}</p>
    <ol class="steps">
      <li><div class="n">1</div><b>{t('hx.qp.s1.t', lang)}</b><p>{t('hx.qp.s1.d', lang)}</p></li>
      <li><div class="n">2</div><b>{t('hx.qp.s2.t', lang)}</b><p>{t('hx.qp.s2.d', lang)}</p></li>
      <li><div class="n">3</div><b>{t('hx.qp.s3.t', lang)}</b><p>{t('hx.qp.s3.d', lang)}</p></li>
    </ol>
    <a class="btn btn-primary" href={L('contacto')}>{t('hx.qp.cta', lang)}</a>
  </div>
</div></section>

<section class="sec" id="flow"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.flow.for', lang)}</p><h2 class="h-md" style="margin:0">Quantix Flow</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('flow.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.flow.more', lang)}</p>
    <a class="link-strong" href={L('quantix-flow')}>{t('cta.know', lang)} Quantix Flow</a>
  </div>
</div></section>

<section class="sec" id="qjuridico"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.jur.for', lang)}</p><h2 class="h-md" style="margin:0">QJurídico</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('jur.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.jur.more', lang)}</p>
    <a class="link-strong" href={L('qjuridico')}>{t('cta.know', lang)} QJurídico</a>
  </div>
</div></section>

<section class="sec" id="qlanza"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.lanza.for', lang)}</p><h2 class="h-md" style="margin:0">QLanza</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('lanza.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.lanza.more', lang)}</p>
    <a class="link-strong" href={L('qlanza')}>{t('cta.know', lang)} QLanza</a>
  </div>
</div></section>

<section class="sec" id="qlinic"><div class="wrap split top">
  <div class="txt"><p class="kicker">{t('hx.cli.for', lang)}</p><h2 class="h-md" style="margin:0">Qlinic</h2></div>
  <div class="media">
    <p class="lead" style="margin-bottom:18px">{t('cli.head.lead', lang)}</p>
    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--ink2)">{t('hx.cli.more', lang)}</p>
    <a class="link-strong" href={L('qlinic')}>{t('cta.know', lang)} Qlinic</a>
  </div>
</div></section>

<section class="sec" id="nosotros"><div class="wrap">
  <h2 class="h-md" style="margin-bottom:48px">{t('work.title', lang)}</h2>
  <div class="feats">
    <div class="feat-item"><h3>{t('work.p1.t', lang)}</h3><p>{t('work.p1.d', lang)}</p></div>
    <div class="feat-item"><h3>{t('work.p2.t', lang)}</h3><p>{t('work.p2.d', lang)}</p></div>
    <div class="feat-item"><h3>{t('work.p3.t', lang)}</h3><p>{t('work.p3.d', lang)}</p></div>
  </div>
</div></section>

<section class="ctaband" id="contacto"><div class="wrap">
  <h2>{t('contact.head.title', lang)}.</h2>
  <p>{t('contact.head.lead', lang)}</p>
  <div class="btn-row">
    <a class="btn btn-primary" href="https://wa.me/573164749204">{t('hx.cta.whatsapp', lang)}</a>
    <a class="btn btn-ghost" href="mailto:info@quantixanalitic.com">info@quantixanalitic.com</a>
  </div>
</div></section>
