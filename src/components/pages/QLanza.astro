---
import { t, getLangFromUrl, localizedPath, splitTitle, kicker, plain } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const QLANZA_APP = 'https://qlanza.quantixanalitic.com';
const modulos = ['m1', 'm2', 'm3', 'm4', 'm5', 'm6'];
const [name, subtitle] = splitTitle(t('lanza.head.title', lang));
---
<section class="sec first" style="padding-top:96px"><div class="wrap">
  <p class="kicker">{kicker(t('lanza.head.eyebrow', lang))}</p>
  <h1 class="h-product">{name}</h1>
  <p class="subtitle" style="max-width:760px">{subtitle}</p>
  <p class="lead">{t('lanza.head.lead', lang)}</p>
  <div class="btn-row">
    <a class="btn btn-primary" href={localizedPath('contacto', lang)}>{t('cta.demo', lang)}</a>
    <a class="btn btn-ghost" href={QLANZA_APP}>{plain(t('lanza.cta.login', lang))}</a>
  </div>
</div></section>
<section class="sec"><div class="wrap note">
  <h2 style="font-size:clamp(34px,4vw,52px)">{t('lanza.nocrm.t', lang)}</h2>
  <p style="font-size:20px">{t('lanza.nocrm.d', lang)}</p>
</div></section>
<section class="sec"><div class="wrap">
  <h2 class="h-md" style="margin-bottom:14px">{t('lanza.mod.title', lang)}</h2>
  <p class="lead" style="margin-bottom:48px">{t('lanza.mod.sub', lang)}</p>
  <div class="feats">
    {modulos.map((m) => (
      <div class="feat-item"><h3>{t(`lanza.${m}.t`, lang)}</h3><p>{t(`lanza.${m}.d`, lang)}</p></div>
    ))}
  </div>
</div></section>
<section class="sec"><div class="wrap note">
  <h2>{t('lanza.sync.t', lang)}</h2>
  <p>{t('lanza.sync.d', lang)}</p>
</div></section>
<section class="ctaband"><div class="wrap">
  <h2>{t('lanza.cta.title', lang)}</h2>
  <p>{t('lanza.cta.sub', lang)}</p>
  <div class="btn-row">
    <a class="btn btn-primary" href={localizedPath('contacto', lang)}>{t('cta.demo', lang)}</a>
    <a class="btn btn-ghost" href={QLANZA_APP}>{plain(t('lanza.cta.login', lang))}</a>
  </div>
</div></section>
